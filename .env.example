# Base Sleuth — Environment Variables
# Copy to .env and fill in your values
#
# docker compose reads this file automatically.

# ── Telegram (REQUIRED for alerts) ────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=clanker
POSTGRES_PASSWORD=clanker
POSTGRES_DB=clanker_tracker
DB_PORT=5432

# ── Optional ───────────────────────────────────────────────
CLANKER_API_KEY=
MINARA_AUTH_METHOD=api_key
MINARA_API_KEY=
# Required only for Minara x402 pay-as-you-go mode.
# Use a dedicated funded wallet; never reuse your main wallet private key.
EVM_PRIVATE_KEY=
LOG_LEVEL=INFO
